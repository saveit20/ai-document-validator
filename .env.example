# Extraction mode: heuristic (default, offline) | llm | hybrid
EXTRACTOR=heuristic
# Claude model used by the llm and hybrid modes
LLM_MODEL=claude-opus-5
# live = call the Anthropic API; replay = use recorded responses in evals/recordings (no key needed)
LLM_TRANSPORT=replay
# Only needed with LLM_TRANSPORT=live
ANTHROPIC_API_KEY=
LLM_TIMEOUT_S=30
LOG_LEVEL=INFO
